{
  "name": "dsh-mana-orchestrate",
  "version": "0.2.0",
  "description": "Mana Orchestrate for DeepSeek Harness: runs the installed Einzbern hook on each step and injects recalled project memory as mana-orchestrate context.",
  "author": "tpmoonchefryan",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "verify:r1a": "node scripts/adversarial-passes-selftest.mjs",
    "verify:licenses": "node scripts/license-inventory.mjs",
    "scrub:evidence": "node scripts/scrub-evidence.mjs",
    "release:artifact": "node scripts/release-artifact.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:compose": "node --test tests/compose/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "lightningcss": "^1.32.0",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "5.9.3"
  }
}
